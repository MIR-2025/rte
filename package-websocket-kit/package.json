    "auto-reconnect",
    "message-queue",
    "pubsub",
    "channels",
    "request-response",
    "heartbeat",
    "isomorphic",
    "browser",
    "nodejs",
    "zero-dependencies",
    "no-dependencies",
    "universal",
    "websocket-kit",
    "websocket-toolkit"
  ],
