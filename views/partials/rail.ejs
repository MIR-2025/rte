<%# Pixboard first-party ad rail. All URLs point at rte.whitneys.co (under the
    opaque path), never at Pixboard -- that is what survives an ad blocker.
    Third-party text (title/headline/body/host) is interpolated and so is
    HTML-escaped by EJS. %>
<aside class="rte-rail" aria-label="Featured">
  <ul class="rte-rail-list">
    <% rail.ads.forEach(function (ad) { %>
      <li class="rte-cell" data-cell="<%= ad.id %>">
        <a class="rte-tile" href="/<%= rail.path %>/<%= ad.id %>/go" target="_blank"
           rel="sponsored noopener" title="<%= ad.title %>"
           aria-describedby="rtecard-<%= ad.id %>">
          <img src="/<%= rail.path %>/<%= ad.id %>" width="40" height="40"
               alt="<%= ad.title %>" loading="lazy" decoding="async">
        </a>
      </li>
    <% }); %>
  </ul>
  <% if (rail.mark) { %>
    <a class="rte-mark" href="<%= rail.mark.href %>" target="_blank" rel="noopener"
       title="<%= rail.mark.title %>">Ads by Pixboard</a>
  <% } %>
</aside>

<%# Flyout cards live OUTSIDE the rail, as siblings, so the rail's scroll/transform
    can never clip them. Each is tied to its tile by data-card and positioned on
    hover with getBoundingClientRect(). %>
<div class="rte-cards" aria-hidden="true">
  <% rail.ads.forEach(function (ad) { var f = ad.flyout; %>
    <article class="rte-card" id="rtecard-<%= ad.id %>" data-card="<%= ad.id %>"
             role="dialog" aria-label="<%= ad.title %>">
      <% if (f.hasHero) { %>
        <div class="rte-card-hero">
          <% if (f.heroType === 'video') { %>
            <video class="rte-hero" muted playsinline preload="none"
                   poster="/<%= rail.path %>/<%= ad.id %>/poster"<%- f.hasAudio ? ' data-hasaudio="1"' : '' %>>
              <%# no src until the card opens -- avoids ~1MB fetched per hidden card %>
              <source data-src="/<%= rail.path %>/<%= ad.id %>/hero" type="video/mp4">
            </video>
          <% } else { %>
            <img class="rte-hero" src="/<%= rail.path %>/<%= ad.id %>/hero" alt=""
                 loading="lazy" decoding="async">
          <% } %>
        </div>
      <% } %>
      <div class="rte-card-body">
        <% if (f.headline) { %><div class="rte-card-h"><%= f.headline %></div><% } %>
        <% if (f.body) { %><p class="rte-card-p"><%= f.body %></p><% } %>
        <div class="rte-card-foot">
          <% if (ad.host) { %><span class="rte-card-host"><%= ad.host %></span><% } %>
          <a class="rte-card-cta" href="/<%= rail.path %>/<%= ad.id %>/go" target="_blank"
             rel="sponsored noopener">Visit &rarr;</a>
        </div>
      </div>
    </article>
  <% }); %>
</div>
