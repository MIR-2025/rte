{
  "name": "rte-rich-text-editor",
  "version": "1.0.34",
  "description": "WYSIWYG rich-text editor in one script tag. Zero dependencies, no framework, no jQuery. Tables, images, links, HTML and Markdown export.",
  "main": "rte.js",
  "module": "rte.esm.js",
  "browser": "rte.js",
  "unpkg": "rte.js",
  "jsdelivr": "rte.js",
  "types": "rte.d.ts",
  "exports": {
    ".": {
      "import": "./rte.esm.js",
      "require": "./rte.js",
      "default": "./rte.js"
    }
  },
  "files": [
    "rte.js",
    "rte.esm.js",
    "rte.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "wysiwyg",
    "wysiwyg-editor",
    "rich-text-editor",
    "rich-text",
    "richtext",
    "text-editor",
    "html-editor",
    "contenteditable",
    "editor",
    "markdown",
    "markdown-editor",
    "embeddable",
    "vanilla-js",
    "no-jquery",
    "zero-dependencies",
    "no-dependencies",
    "umd",
    "browser",
    "standalone",
    "rte"
  ],
  "author": "phpMyDEV, LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIR-2025/rte.git"
  },
  "bugs": {
    "url": "https://github.com/MIR-2025/rte/issues"
  },
  "homepage": "https://rte.whitneys.co",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
